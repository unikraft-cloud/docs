      },
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "table",
      "title": "Instance states",
      "description": "Current state, uptime and RSS per active instance",
      "targets": [
        {
          "refId": "A",
          "expr": "instance_state{job=\"instances\", instance_uuid=~\"$instance\"}",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "instance_uptime_s{job=\"instances\", instance_uuid=~\"$instance\"}",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "instance_rss_bytes{job=\"instances\", instance_uuid=~\"$instance\"}",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "instance_uuid",
            "mode": "outer"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(instance_uuid|Value #.*)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "instance_uuid": "instance",
              "Value #A": "state",
              "Value #B": "uptime",
              "Value #C": "RSS"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "state"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "stopped",
                        "color": "text"
                      },
                      "1": {
                        "text": "starting",
                        "color": "blue"
                      },
                      "2": {
                        "text": "running",
                        "color": "green"
                      },
                      "3": {
                        "text": "draining",
                        "color": "yellow"
                      },
                      "4": {
                        "text": "stopping",
                        "color": "orange"
                      },
                      "5": {
                        "text": "standby",
                        "color": "purple"
                      },
                      "6": {
                        "text": "template",
                        "color": "blue"
                      },
                      "7": {
                        "text": "deleted",
                        "color": "red"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "uptime"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RSS"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
