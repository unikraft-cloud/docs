      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "stat",
      "title": "Total RSS",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(instance_rss_bytes{job=\"instances\", instance_uuid=~\"$instance\"}) or vector(0)",
